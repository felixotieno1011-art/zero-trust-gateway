# Single image for auth_service, gateway, and mock services.
# The CMD is overridden per-service in docker-compose.yml.
FROM python:3.12-slim

# Don't run as root
RUN useradd -m -u 1000 appuser

WORKDIR /app

# System deps needed for pg8000/bcrypt build (kept minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY auth_service/ auth_service/
COPY gateway/ gateway/
COPY mock_service_a/ mock_service_a/
COPY mock_service_b/ mock_service_b/

# Drop privileges
RUN chown -R appuser:appuser /app
USER appuser

# Health check endpoint default (overridden per service)
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${PORT:-8000}/health', timeout=2)" || exit 1

# Default command (overridden per service)
CMD ["python", "-m", "uvicorn", "auth_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
